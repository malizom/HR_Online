{
  "name": "people-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant people portal for professional-services firms (first tenant: MVR Attorneys)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "db:rls": "tsx scripts/gen-rls.mjs ./db/schema/index.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx db/seed/run.ts",
    "jobs": "tsx jobs/run.ts",
    "db:reset": "bash scripts/reset-dev-db.sh"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@azure/keyvault-secrets": "^4.12.0",
    "@azure/storage-blob": "^12.34.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.468.0",
    "next": "^15.5.28",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}