# ---- Local development (npm run db:reset; npm run dev) ----
# The app connects as a non-superuser login so row-level security is real. Migrations use the owner.
DATABASE_URL="postgresql://pp_app_login:dev_only_pw@localhost:5432/people_dev"
MIGRATION_DATABASE_URL="postgresql://owner:owner@localhost:5432/people_dev"
DEV_APP_LOGIN_PASSWORD="dev_only_pw"        # creates pp_app_login on migrate; never set in Azure

AUTH_SECRET="generate: openssl rand -base64 32"
AUTH_TRUST_HOST="true"                      # do NOT set AUTH_URL: each firm signs in on its own host

DEV_LOGIN="true"                            # email-only sign-in for seeded people; ignored in production builds
DEV_FIRM_SLUG="demo"                        # localhost maps to this firm; demo.localhost also works

DATA_ENCRYPTION_KEY="generate: openssl rand -base64 32"   # Azure: Key Vault secret data-encryption-key
UPLOAD_DIR="./uploads"                      # Azure: STORAGE_DRIVER=azure + AZURE_STORAGE_ACCOUNT_URL

# ---- Set by infra/main.bicep in Azure (listed for reference) ----
# NODE_ENV=production PG_ENTRA_AUTH=true PG_SSL=true KEY_VAULT_URL=... STORAGE_DRIVER=azure
# AZURE_STORAGE_ACCOUNT_URL=... AZURE_CLIENT_ID=<app identity> APPLICATIONINSIGHTS_CONNECTION_STRING=...
# Per-firm Entra client secrets live in Key Vault as firm-<slug>-entra-secret (firms.entra_secret_ref).
