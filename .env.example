# --- Database (Postgres) ---
DATABASE_URL="postgresql://mvr:mvr@localhost:5432/mvr_people?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Microsoft 365 / Entra ID sign-in (MVR's email is on M365).
# Register an app in Entra ID: Redirect URI = {AUTH_URL}/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"

# Local development only: allows signing in as any email in the People table
# with no password. NEVER set this in production.
DEV_LOGIN="false"

# First administrator — created on `npm run db:seed` if not present
ADMIN_NAME="Malizo Magangane"
ADMIN_EMAIL="malizo.magangane@me.com"

# Where uploaded staff documents are stored (outside the web root)
UPLOAD_DIR="./uploads"
